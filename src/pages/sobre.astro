---
import Base from '../layouts/Base.astro';
import CapaPagina from '../components/CapaPagina.astro';
import Icone from '../components/Icone.astro';
import { site, url, whatsapp } from '../lib/site';
const { historia, numeros, empresa } = site;
---
<Base titulo="Sobre nós" descricao="Conheça a história, a missão e os valores da LS Corretora de Seguros. Desde 2011 protegendo famílias e empresas em São Paulo.">
  <CapaPagina olho="Sobre a LS" titulo={`Fundados em ${empresa.desde} com um propósito claro`} texto="15 anos protegendo famílias e empresas em São Paulo com atendimento humano e soluções sob medida." migalhas={[{ rotulo: 'Sobre nós' }]} />
  <section class="s" style="padding-top:40px">
    <div class="w duas">
      <div class="prosa">{historia.paragrafos.map((p, i) => <p class="surge" style={`--i:${i}`}>{p}</p>)}</div>
      <div class="faixa surge zoom numeros" style="margin:0;grid-template-columns:1fr 1fr">{numeros.map((n) => <div><b data-conta>{n.valor}</b><span>{n.rotulo}</span></div>)}</div>
    </div>
  </section>
  <section class="s">
    <div class="w duas">
      <div class="cab surge lado" style="margin:0"><div><span class="olho">Nossa trajetória</span><h2>Uma história de confiança</h2></div></div>
      <div class="tempo linha">{historia.linhaDoTempo.map((t, i) => <div class="surge marco" style={`--i:${i}`}><b>{t.ano}</b><h3>{t.titulo}</h3><p>{t.texto}</p></div>)}</div>
    </div>
  </section>
  <section class="s">
    <div class="w">
      <div class="cab surge"><div><span class="olho">Nossa essência</span><h2>Missão, visão e valores</h2></div></div>
      <div class="mvv">
        <div class="surge" style="--i:0"><Icone nome="target" peso="light" /><h3>Missão</h3><p>{historia.missao}</p></div>
        <div class="surge" style="--i:1"><Icone nome="binoculars" peso="light" /><h3>Visão</h3><p>{historia.visao}</p></div>
        <div class="surge" style="--i:2"><Icone nome="hand-heart" peso="light" /><h3>Valores</h3><ul>{historia.valores.map((v) => <li>{v}</li>)}</ul></div>
      </div>
    </div>
  </section>
  <section class="s">
    <div class="w">
      <div class="faixa surge zoom" style="grid-template-columns:1fr;text-align:center;justify-items:center">
        <div><h2 style="font-size:28px">Vamos proteger o que importa para você?</h2><p style="margin-top:8px">Cotação gratuita, com uma pessoa de verdade do outro lado.</p></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center"><a class="bt br" href={`${url('')}#contato`}>Pedir cotação gratuita</a><a class="bt zap" href={whatsapp()} target="_blank" rel="noopener"><Icone nome="whatsapp-logo" />Chamar no WhatsApp</a></div>
      </div>
    </div>
  </section>
</Base>
